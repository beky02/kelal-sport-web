# ── Server only ──────────────────────────────────────────────────────────────
# The browser never calls the API (D3): route handlers under /api do, from the
# server. Locally this is Prism serving the contract's examples (the backend's
# docker-compose runs it on :4010); later the FastAPI backend on :8000.
API_BASE_URL=http://localhost:4010

# Move screens to the real backend one contract tag at a time (D7): calls whose
# OpenAPI tag is listed go to API_REAL_URL, the rest stay on API_BASE_URL.
API_REAL_URL=
API_REAL_TAGS=

# Tenant sent as X-Tenant-Id. Hosts in the map win; anything else gets the default.
DEFAULT_TENANT=demo
TENANT_HOST_MAP=localhost=demo

# The shop terminal's hosts (FD1, F8a), host=tenant like TENANT_HOST_MAP: a host
# here serves only the terminal (/terminal/*, /api/terminal/*; its / shows
# /terminal), every other host is the player site. A host may not be in both
# maps. Unset in production: no host serves the terminal. Unset elsewhere:
# terminal.localhost for DEFAULT_TENANT, so http://terminal.localhost:3000 works
# in `pnpm dev` (Chrome sends any *.localhost to this machine).
TERMINAL_HOST_MAP=terminal.localhost=demo

# ── Browser ──────────────────────────────────────────────────────────────────
# Realtime gateway (odds, scores, market status). Release 2.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/realtime

NEXT_PUBLIC_APP_ENV=development

# Serve the in-repo mock repository for the one feature not yet rewired to the
# contract (session activity, until F7b). Everything else ignores it.
NEXT_PUBLIC_USE_MOCKS=true

# Realtime odds. Release 1 polls every 30 s with this `off` (D5). `on` connects
# to NEXT_PUBLIC_WS_URL; `simulate` moves the prices on screen locally.
NEXT_PUBLIC_REALTIME=off

# Release 2 features, built and hidden (D8). `true` shows them locally.
NEXT_PUBLIC_FEATURE_LIVE=false
NEXT_PUBLIC_FEATURE_CASH_OUT=false

# ── Session (F4) ─────────────────────────────────────────────────────────────
# Seals the httpOnly session cookie that holds the API's tokens (AES-256-GCM).
# At least 32 characters; required in production (the server refuses to start
# without it). Unset locally, a development-only key is used.
#   openssl rand -base64 48
SESSION_SECRET=

# While rotating SESSION_SECRET: the previous value, so cookies sealed with it
# still open until they expire. Leave empty otherwise.
SESSION_SECRET_PREVIOUS=

# How many of our own proxies sit in front of this server and append to
# X-Forwarded-Host / -Proto / -For. 0 (default): only Host is believed, so a
# forged forwarded header cannot pick the tenant or the player's address.
# Behind one edge: 1. The n-th entry from the right of each header is the one
# the edge added; the edge must append (or overwrite), never pass a client's
# header through as its own.
TRUSTED_PROXY_HOPS=0

# Token refresh is deduplicated per process. Run one replica, or route /api/*
# with sticky sessions, until the refresh coordination moves to Redis or the
# backend adds a reuse grace window (F4 verification, SEC4).

# ── Payments (F6b) ───────────────────────────────────────────────────────────
# The payment providers' pages a deposit may send a player to, as exact host
# names, comma-separated: checkout.chapa.co,app.ethiotelecom.et. https only, no
# wildcards; any other page is refused. Unset in production: none, so every
# redirect is refused until hosts are listed. Unset elsewhere: the two hosts in
# the contract's examples, so Prism's deposits can be followed.
PAYMENT_REDIRECT_HOSTS=
