# Backend REST base. Versioned from day one so /api/v2 can coexist later.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Realtime gateway (odds, scores, market status).
NEXT_PUBLIC_WS_URL=ws://localhost:8000/realtime

NEXT_PUBLIC_APP_ENV=development

# Serve the in-repo mock repository instead of calling the backend.
# Set to false once the API is up; no UI code changes.
NEXT_PUBLIC_USE_MOCKS=true

# Realtime odds. `on` connects to NEXT_PUBLIC_WS_URL; `simulate` drives the same
# parse → patch cache → re-render path locally so it is exercised without a
# gateway; `off` disables it.
NEXT_PUBLIC_REALTIME=simulate
